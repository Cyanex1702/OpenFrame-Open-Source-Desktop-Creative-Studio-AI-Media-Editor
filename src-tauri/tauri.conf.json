{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFrame",
  "version": "0.12.0",
  "identifier": "org.openframe.studio",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "OpenFrame — The free, open-source creative studio",
      "width": 1440,
      "height": 900,
      "minWidth": 1040,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "backgroundColor": "#080a0d",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenFrame contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../vendor/ffmpeg/bin/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "../vendor/ffmpeg/bin/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "../vendor/ffmpeg/LICENSE": "ffmpeg/LICENSE.txt",
      "../vendor/ffmpeg/README.txt": "ffmpeg/README.txt",
      "../vendor/ffmpeg/SHA256SUMS.txt": "ffmpeg/SHA256SUMS.txt",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "shortDescription": "The free, open-source creative studio.",
    "longDescription": "A local-first desktop video editor and visual design studio without subscriptions, ads, or lock-in.",
    "windows": { "nsis": { "installMode": "currentUser", "compression": "zlib" } }
  }
}

